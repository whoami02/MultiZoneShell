<Application x:Class="MultiZoneShell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- macOS Dark Mode Palette -->
        <SolidColorBrush x:Key="MacCanvasBrush" Color="#000000" />
        <SolidColorBrush x:Key="MacSurfaceBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="MacHeaderBrush" Color="#242426" />
        <SolidColorBrush x:Key="MacHeaderActiveBrush" Color="#2C2C2E" />
        <SolidColorBrush x:Key="MacBorderBrush" Color="#38383A" />
        <SolidColorBrush x:Key="MacAccentBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="MacPillBrush" Color="#3A3A3C" />
        <SolidColorBrush x:Key="MacPillHoverBrush" Color="#48484A" />
        <SolidColorBrush x:Key="MacTextPrimaryBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="MacTextSecondaryBrush" Color="#98989D" />
        <SolidColorBrush x:Key="MacDividerPillBrush" Color="#636366" />
        <SolidColorBrush x:Key="MacDividerPillHoverBrush" Color="#0A84FF" />

        <!-- macOS Overlay-style Slim ScrollBar Thumb -->
        <Style x:Key="MacScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#808E8E93"
                                CornerRadius="4"
                                Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#CCAEAEB2" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF0A84FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible RepeatButton for ScrollBar track -->
        <Style x:Key="MacScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Dark Slim ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="#18181A">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource MacScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MacScrollBarThumb}" MinHeight="24" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource MacScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="#18181A">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource MacScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MacScrollBarThumb}" MinWidth="24" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource MacScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- macOS Split View Vertical Divider Style -->
        <Style x:Key="MacVerticalSplitterStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#0A0A0C" />
            <Setter Property="Width" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <Border x:Name="Pill"
                                    Width="4"
                                    Height="44"
                                    CornerRadius="2"
                                    Background="{StaticResource MacDividerPillBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#161F2E" />
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource MacDividerPillHoverBrush}" />
                                <Setter TargetName="Pill" Property="Height" Value="64" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#240A84FF" />
                                <Setter TargetName="Pill" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Pill" Property="Height" Value="80" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Split View Horizontal Divider Style -->
        <Style x:Key="MacHorizontalSplitterStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#0A0A0C" />
            <Setter Property="Height" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <Border x:Name="Pill"
                                    Width="44"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="{StaticResource MacDividerPillBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#161F2E" />
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource MacDividerPillHoverBrush}" />
                                <Setter TargetName="Pill" Property="Width" Value="64" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#240A84FF" />
                                <Setter TargetName="Pill" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Pill" Property="Width" Value="80" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Dark Mode ContextMenu & MenuItem Styles -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="#F2242426"
                                BorderBrush="#66636366"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="5">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#44636366" Margin="8,4,8,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="12,6,16,6"
                                Margin="1">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource MacAccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
